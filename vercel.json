{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/finden",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/entdecken",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/create",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/zubehoer",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/blog",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/blog/:slug",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/ueber-uns",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/kontakt",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/impressum",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/datenschutz",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/agent-md/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
